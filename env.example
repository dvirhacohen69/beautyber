# ---- Server ----
NODE_ENV=development
PORT=3000
API_BASE_PATH=/v1

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://bod_user:bod_password@localhost:5432/beauty_on_demand?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Auth / JWT ----
JWT_ACCESS_SECRET="replace-with-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-different-strong-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ---- OTP ----
OTP_EXPIRES_IN_SECONDS=300
OTP_LENGTH=6

# ---- Payments (Stripe Connect) ----
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
PLATFORM_COMMISSION_RATE=0.20

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY="replace-with-google-maps-api-key"

# ---- Push Notifications ----
FCM_SERVER_KEY="replace-with-fcm-server-key"

# ---- SMS Fallback ----
SMS_PROVIDER_API_KEY="replace-with-sms-provider-key"

# ---- Misc ----
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL=info
